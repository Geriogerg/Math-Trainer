# LF line endings in the repo whatever the Windows editor: without this, an
# editor rewriting in CRLF makes whole files look modified with no real
# change.
*.dart text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Scripts run on Linux in CI: a CR breaks bash there (Git Bash tolerates it).
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.toml text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.bat text eol=crlf
*.png binary
