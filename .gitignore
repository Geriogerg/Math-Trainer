#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
# Artefacts written by flutter test when a golden comparison fails
# (diff/masked/master/test images) — never source code.
test/**/failures/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Supabase configuration (URL + publishable key) — versioned template:
# dart_defines.example.json
/dart_defines.json
